#!/usr/bin/make -f
#
# Build rules for the qspacemidi Debian package.
#
# The build fetches libremidi with CMake's FetchContent, so it needs network
# access.  When building in an isolated environment, point CMake at a local
# checkout instead:
#
#   dpkg-buildpackage -us -uc -b \
#     --build-option=-DFETCHCONTENT_SOURCE_DIR_LIBREMIDI=/path/to/libremidi
#
# libremidi is linked statically, so the binary package only depends on Qt,
# ALSA and udev.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DFETCHCONTENT_FULLY_DISCONNECTED=OFF \
		-DFETCHCONTENT_QUIET=OFF \
		-DQSPACEMIDI_UDEV_RULES_DIR=/usr/lib/udev/rules.d

# CMake older than 3.28 cannot drop the install rules of the bundled
# libremidi, so remove its development files from the staging tree.
override_dh_auto_install:
	dh_auto_install
	rm -rf debian/qspacemidi/usr/include/libremidi
	rm -rf debian/qspacemidi/usr/lib/cmake/libremidi
	rm -f debian/qspacemidi/usr/lib/*/liblibremidi.a
	rmdir --ignore-fail-on-non-empty -p debian/qspacemidi/usr/lib/cmake 2>/dev/null || true

# There is no test suite yet.
override_dh_auto_test:
